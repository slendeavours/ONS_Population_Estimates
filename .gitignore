# Secrets and local config — never committed
.env
.env.*
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# Raw source downloads (re-fetchable from ONS; see scripts/s18_pipr_fetch.py)
data/raw/

# Stat-Xplore API response cache (local only, re-fetchable)
s19_cache/

# Local tooling
.claude/
.vscode/

# Deliverables. Some carry commercial rate card figures (S20), which must never
# reach this remote. The node docs under outputs/node_docs/ are tracked and stay
# tracked; everything else in outputs/ is local only.
outputs/*
!outputs/node_docs/
SKILLS/

# Liverpool assurance work. verify/src holds published source files pulled down
# for the 2026-08-20 reconciliation: 63MB, re-fetchable from the publisher, and
# ignored on the same basis as data/raw. outputs holds the rendered paper, which
# is regenerated from extract.py and build_paper.py. The scripts, template and
# extracted data.json are tracked, because those are the source.
Liverpool/verify/src/
# Liverpool paper output goes to ucws-repo/outputs, outside this repository
# entirely, so no rule is needed for it here.

# S20 commercial rate card. The registry marks source 20 confidential with
# publish_github false: the figures are held in exempt_pipeline only and must
# never reach this remote. The rate files carry per-area weekly rates outright
# and the build and prompt files quote them, so the whole prefix is excluded
# rather than picked over file by file. These sat outside the repository until
# the 2026-08-20 consolidation moved them in; this rule is what keeps that
# move safe.
#
# The prefix is deliberately neutral. Source 20's completeness_note records
# that the counterparty is named by its own table and file names, so a pattern
# matching those names would disclose it here. The files are named for the
# source number instead.
s20_ratecard_*

# Database dumps - never commit, even accidentally
*.sql
*.dump
*.sql.gz
*.backup
db-backups/
backups/

# Narrow exception: sql/ holds schema DDL, which is source and belongs in
# version control. The rule above exists to stop dumps, not definitions.
# Nothing else is un-ignored, and a dump must never be written to sql/.
!sql/*.sql
