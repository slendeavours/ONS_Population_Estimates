# Secrets and local config — never committed
.env
.env.*
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# Raw source downloads (re-fetchable from ONS; see scripts/s18_pipr_fetch.py)
data/raw/

# Stat-Xplore API response cache (local only, re-fetchable)
s19_cache/

# Local tooling
.claude/
.vscode/

# Deliverables. Some carry commercial rate card figures (S20), which must never
# reach this remote. The node docs under outputs/node_docs/ are tracked and stay
# tracked; everything else in outputs/ is local only.
outputs/*
!outputs/node_docs/
SKILLS/

# Source assurance downloads. scripts/verify/src holds published source files
# pulled down for the 2026-08-20 reconciliation: 63MB, re-fetchable from the
# publisher, and ignored on the same basis as data/raw.
scripts/verify/src/
# W1 node SQL exported from n8ndb for inspection. n8ndb is the only source of
# truth for node queries; a checked-in copy silently goes stale, which cost a
# long debugging session on 2026-08-20. Never commit one.
scripts/verify/w1_live/

# S20 commercial rate card. The registry marks source 20 confidential with
# publish_github false: the figures are held in exempt_pipeline only and must
# never reach this remote. The rate files carry per-area weekly rates outright
# and the build and prompt files quote them, so the whole prefix is excluded
# rather than picked over file by file. These sat outside the repository until
# the 2026-08-20 consolidation moved them in; this rule is what keeps that
# move safe.
#
# The prefix is deliberately neutral. Source 20's completeness_note records
# that the counterparty is named by its own table and file names, so a pattern
# matching those names would disclose it here. The files are named for the
# source number instead.
s20_ratecard_*

# Database dumps - never commit, even accidentally
*.sql
*.dump
*.sql.gz
*.backup
db-backups/
backups/

# Narrow exception: sql/ holds schema DDL, which is source and belongs in
# version control. The rule above exists to stop dumps, not definitions.
# Nothing else is un-ignored, and a dump must never be written to sql/.
!sql/*.sql
# W1 step definitions (sql/w1) are source too, not dumps.
!sql/w1/*.sql

# Estate-tracing name lists (personal data of deceased individuals) - never public
UnclaimedEstatesList.csv
bona_vacantia_estates_*.csv

# data/reference holds small CSV copies the pipeline reads (tracked). Publisher
# originals are re-fetchable downloads and follow the data/raw rule; working and
# evidence files from the 2026-10 revision work stay local; _1 is a stale variant.
data/reference/*.xlsx
data/reference/*.ods
data/reference/LAHS_open_data_*.csv
data/reference/rough_sleeping_snapshot_2025_1.csv
data/reference/statutory_homelessness_2025Q2_comparison.csv
data/reference/statutory_homelessness_2025Q2_support_needs_before_revision.csv
desktop.ini
